---
import '../styles/global.css';

const questions = [
  { question: 'What is cybersecurity, and why is it important in the UK or RO?', answer: [
    'Cybersecurity involves protecting systems, networks, and data from cyber threats such as hacking, phishing, and malware attacks. In the UK or RO, robust cybersecurity is crucial to safeguard personal information, maintain the integrity of critical infrastructure, and protect businesses from financial losses and reputational damage.'
  ]},
  { question: 'What are the most common types of cyber threats faced by organizations?', answer: [
    'Organizations commonly face several cyber threats, including:',
    'Phishing Attacks: Deceptive emails or messages designed to trick individuals into revealing sensitive information.',
    'Ransomware: Malware that encrypts data, demanding payment for release.',
    'Denial-of-Service (DoS) Attacks: Overloading systems with excessive traffic to disrupt services.',
    'Advanced Persistent Threats (APTs): Sophisticated, prolonged cyberattacks often orchestrated by state-sponsored groups.'
  ]},
  { question: 'How can UK businesses enhance their cybersecurity measures?', answer: [
    'Businesses can bolster cybersecurity by implementing several key strategies:',
    'Regular Security Audits: Conduct assessments to identify and address vulnerabilities.',
    'Employee Training: Educate staff on recognizing phishing attempts and adhering to security protocols.',
    'Data Encryption: Utilize encryption to protect sensitive information during storage and transmission.',
    'Multi-Factor Authentication (MFA): Require multiple forms of verification to access systems, enhancing access security.',
    'Incident Response Planning: Develop and regularly update plans to respond effectively to cybersecurity incidents.',
    'By proactively addressing these areas, UK or RO businesses can significantly reduce the risk of cyber threats and ensure the security of their operations and customer data.'
  ]}
];

const partners = [
  { src: '/assets/vercara.webp', alt: 'Vercara — a DigiCert company', name: 'vercara' },
  { src: '/assets/cloudflare.webp', alt: 'Cloudflare', name: 'cloudflare' },
  { src: '/assets/xcitium.svg', alt: 'XCITIUM', name: 'xcitium' },
  { src: '/assets/telekom-business-partner.webp', alt: 'Telekom Business Partner', name: 'telekom' },
  { src: '/assets/20i.svg', alt: '20i', name: 'twentyi' },
  { src: '/assets/newfold.svg', alt: 'Newfold Digital', name: 'newfold' },
  { src: '/assets/iubenda-bronze.png', alt: 'iubenda Bronze', name: 'iubenda' },
  { src: '/assets/logo-seap.webp', alt: 'SEAP — Sistemul Electronic de Achiziții Publice', name: 'seap' },
  { src: '/assets/zb-partner.webp', alt: 'ZebraByte brand mark', name: 'zb' }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="ZebraByte delivers managed cybersecurity, managed compliance and secure managed hosting for organisations that take security seriously." />
    <meta name="theme-color" content="#0f0d17" />
    <link rel="icon" type="image/webp" href="/assets/favicon.webp" />
    <title>ZebraByte — Managed Cybersecurity, Compliance &amp; Secure Hosting</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="intro intro--orbital" aria-labelledby="intro-title">
        <div class="intro-globe" aria-hidden="true">
          <canvas id="zbt-globe" class="intro-globe-canvas" width="1000" height="1000"></canvas>
          <div class="intro-globe-fallback"></div>
        </div>
        <div class="intro-copy">
          <a class="intro-brand" href="https://www.zebrabyte.ro/" aria-label="ZebraByte website">
            <img src="/assets/zebrabyte-white.svg" alt="ZebraByte" width="190" height="69" fetchpriority="high" />
          </a>
          <p class="intro-eyebrow">MANAGED CYBERSECURITY <span aria-hidden="true">·</span> COMPLIANCE <span aria-hidden="true">·</span> HOSTING</p>
          <h1 id="intro-title">Cybersecurity.<br />Compliance.<br /><em>Secure hosting.</em></h1>
          <p class="intro-lede">Protection you can depend on. Compliance you can demonstrate. Infrastructure built to withstand real threats.</p>
          <p class="intro-detail">Managed security, regulatory readiness and resilient hosting — delivered together by ZebraByte.</p>
          <div class="intro-actions">
            <a class="website-button" href="https://www.zebrabyte.ro/">Explore ZebraByte <span aria-hidden="true">↗</span></a>
            <a class="intro-secondary" href="#services">Our expertise <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section id="services" class="services" aria-labelledby="services-heading">
        <div class="section-heading">
          <p class="section-kicker">WHAT WE DO</p>
          <h2 id="services-heading">Security, from policy to infrastructure.</h2>
          <p class="section-lead">Three connected services. One accountable partner.</p>
        </div>
        <div class="service-grid">
          <article class="service-card">
            <span class="service-number" aria-hidden="true">01 / PROTECT</span>
            <h3>Managed Cybersecurity</h3>
            <p>Continuous security oversight, risk reduction, threat monitoring and practical incident readiness.</p>
            <span class="service-meta">DEFENCE · MONITORING · RESPONSE</span>
          </article>
          <article class="service-card">
            <span class="service-number" aria-hidden="true">02 / GOVERN</span>
            <h3>Managed Compliance</h3>
            <p>Structured compliance programmes, evidence management and support for GDPR, ISO 27001 and NIS2 readiness.</p>
            <span class="service-meta">GOVERNANCE · RISK · EVIDENCE</span>
          </article>
          <article class="service-card">
            <span class="service-number" aria-hidden="true">03 / OPERATE</span>
            <h3>Managed Hosting</h3>
            <p>Resilient web infrastructure, secure configurations, monitoring and managed operational support.</p>
            <span class="service-meta">CLOUD · AVAILABILITY · SUPPORT</span>
          </article>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently Asked Questions</h2>
        <p class="faq-lead">Answers to questions about the security challenges we help organisations address.</p>
        <div class="faq-accordion">
          {questions.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <div class="faq-answer">{item.answer.map((paragraph) => <p>{paragraph}</p>)}</div>
            </details>
          ))}
        </div>
      </section>

      <section class="partners" aria-labelledby="partners-title">
        <h2 id="partners-title">Our partners</h2>
        <div class="partner-logos">
          {partners.map((partner) => (
            <div class={''+ 'partner partner--' + partner.name}>
              <img src={partner.src} alt={partner.alt} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </section>
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-main">
          <div class="footer-identity">
            <a href="https://www.zebrabyte.ro/" aria-label="ZebraByte homepage" class="footer-brand">
              <img src="/assets/zebrabyte-white.svg" alt="ZebraByte" width="176" height="64" loading="lazy" decoding="async" />
            </a>
          </div>
          <div class="footer-info" lang="ro">
            <section class="footer-info-group" aria-label="Sediul social">
              <h3>Sediul social</h3>
              <address>Suite 7165a<br />60 Tottenham Court Road<br />Fitzrovia, London<br />United Kingdom, W1T 2EW</address>
            </section>
            <section class="footer-info-group" aria-label="Informații juridice">
              <h3>Informații juridice</h3>
              <p>ZEBRABYTE LIMITED este companie înregistrată în Anglia și Țara Galilor.</p>
              <p>Company Number: <strong>15194067</strong></p>
              <p>ICO Registration Number: <strong>ZB748706</strong></p>
            </section>
          </div>
        </div>
        <div class="footer-bottom" lang="ro">
          <p>© 2026 ZEBRABYTE LIMITED. Toate drepturile rezervate.</p>
        </div>
      </div>
    </footer>
  <script is:inline src="/scripts/zbt-orbit.js" defer></script>
  </body>
</html>
